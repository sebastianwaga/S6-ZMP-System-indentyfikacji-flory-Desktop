<Application x:Class="VirtualHerbarium.AdminPanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VirtualHerbarium.AdminPanel.ViewModels"
             xmlns:views="clr-namespace:VirtualHerbarium.AdminPanel.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnLastWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <materialDesign:BundledTheme BaseTheme="Light"
                                 PrimaryColor="Green"
                                 SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />


                <ResourceDictionary Source="Localization/Strings.pl.xaml" />

            </ResourceDictionary.MergedDictionaries>


            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Color x:Key="AccentGreen">#FF4CAF50</Color>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}" />

            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <views:UsersView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PlantsViewModel}">
                <views:PlantsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CollectionsViewModel}">
                <views:CollectionsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
                <views:NotificationsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StatsViewModel}">
                <views:StatsView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
