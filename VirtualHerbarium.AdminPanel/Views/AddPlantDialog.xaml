<Window x:Class="VirtualHerbarium.AdminPanel.Views.AddPlantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddPlant_Title}"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource AddPlant_Name}"/>
            <TextBox x:Name="NameBox" Margin="0 5 0 10"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{DynamicResource AddPlant_Photo}"/>
            <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                <TextBox x:Name="PhotoPathBox" Width="220" IsReadOnly="True"/>
                <Button Content="{DynamicResource AddPlant_Choose}"
                        Width="80"
                        Margin="10 0 0 0"
                        Click="ChoosePhoto_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource AddPlant_HerbariumId}"/>
            <TextBox x:Name="HerbariumBox" Margin="0 5 0 10"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource AddPlant_Cancel}" Width="80" Margin="0 0 10 0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource AddPlant_Add}" Width="80" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
