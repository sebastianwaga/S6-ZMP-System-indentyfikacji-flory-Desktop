<Window x:Class="VirtualHerbarium.AdminPanel.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Logowanie"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AccentGreenBrush}">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Logowanie administratora"
                       FontSize="20"
                       Margin="0 0 0 20"
                       HorizontalAlignment="Center"
                       Foreground="White"/>

            <TextBox Margin="0 10"
                     materialDesign:HintAssist.Hint="Login"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <PasswordBox Margin="0 10"
                         x:Name="PasswordBox"
                         materialDesign:HintAssist.Hint="Hasło"
                         PasswordChanged="PasswordBox_OnPasswordChanged"/>

            <Button Content="Zaloguj"
                    Command="{Binding LoginCommand}"
                    Height="40"
                    Margin="0 20 0 0"
                    Background="White"
                    Foreground="Black"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
