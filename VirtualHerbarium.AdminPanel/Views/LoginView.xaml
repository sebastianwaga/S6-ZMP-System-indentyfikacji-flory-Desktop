<Window x:Class="VirtualHerbarium.AdminPanel.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource Login_Title_Window}"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AccentGreenBrush}">

	<Grid Margin="20">

		<!-- PRZEŁĄCZNIK JĘZYKA -->
		<StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,0,10">

			<Button Content="PL"
                    Width="40"
                    Margin="0,0,6,0"
                    Command="{Binding ChangeLanguageCommand}"
                    CommandParameter="pl"
                    Background="White"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand"/>

			<Button Content="EN"
                    Width="40"
                    Command="{Binding ChangeLanguageCommand}"
                    CommandParameter="en"
                    Background="White"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand"/>
		</StackPanel>

		<StackPanel VerticalAlignment="Center">

			<TextBlock Text="{DynamicResource Login_Title_Header}"
                       FontSize="20"
                       Margin="0 0 0 10"
                       HorizontalAlignment="Center"
                       Foreground="White"/>

			<TextBlock Text="{DynamicResource Login_Label_Username}"
                       Foreground="White"
                       Margin="0,0,0,2"/>

			<TextBox Background="White"
                     Foreground="Black"
                     BorderBrush="#1976D2"
                     BorderThickness="1"
                     Height="36"
                     Padding="8"
                     Margin="0,0,0,8"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

			<TextBlock Text="{DynamicResource Login_Label_Password}"
                       Foreground="White"
                       Margin="0,4,0,2"/>

			<PasswordBox Background="White"
                         Foreground="Black"
                         BorderBrush="#1976D2"
                         BorderThickness="1"
                         Height="36"
                         Padding="8"
                         Margin="0,0,0,12"
                         Name="PasswordBox"/>

			<Button Content="{DynamicResource Login_Button_SignIn}"
                    Command="{Binding LoginCommand}"
                    Height="40"
                    Margin="0 10 0 10"
                    Background="White"
                    Foreground="Black"/>

			<TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       HorizontalAlignment="Center"/>
		</StackPanel>
	</Grid>
</Window>
