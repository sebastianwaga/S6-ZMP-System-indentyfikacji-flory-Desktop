<Window x:Class="VirtualHerbarium.AdminPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:VirtualHerbarium.AdminPanel.ViewModels"
        xmlns:views="clr-namespace:VirtualHerbarium.AdminPanel.Views"
        mc:Ignorable="d"
        Title="{DynamicResource Main_Title}"
        Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AccentGreenBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   Background="{DynamicResource PrimaryHueMidBrush}"
                   LastChildFill="True">

            <TextBlock Text="{DynamicResource Main_Header}"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="16,0" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">

                <Button Content="PL"
                        Width="40"
                        Margin="0,0,6,0"
                        Command="{Binding ChangeLanguageCommand}"
                        CommandParameter="pl"
                        Background="White"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="EN"
                        Width="40"
                        Command="{Binding ChangeLanguageCommand}"
                        CommandParameter="en"
                        Background="White"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>

        </DockPanel>

        <StackPanel Grid.Column="0" Grid.Row="1"
                    Background="White">
            <TextBlock Text="{DynamicResource Main_Navigation}"
                       Margin="16,16,16,8"
                       FontWeight="Bold"
                       FontSize="14" />

            <ListBox SelectedValuePath="Tag"
                     SelectedValue="{Binding SelectedMenu}">
                <ListBoxItem Content="{DynamicResource Main_Menu_Users}" Tag="Users" />
                <ListBoxItem Content="{DynamicResource Main_Menu_Plants}" Tag="Plants" />
                <ListBoxItem Content="{DynamicResource Main_Menu_Collections}" Tag="Collections" />
                <ListBoxItem Content="{DynamicResource Main_Menu_Notifications}" Tag="Notifications" />
                <ListBoxItem Content="{DynamicResource Main_Menu_Stats}" Tag="Stats" />
            </ListBox>
        </StackPanel>

        <ContentControl Grid.Column="1" Grid.Row="1"
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
