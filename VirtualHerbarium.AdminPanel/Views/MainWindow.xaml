<Window x:Class="VirtualHerbarium.AdminPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:VirtualHerbarium.AdminPanel.ViewModels"
        xmlns:views="clr-namespace:VirtualHerbarium.AdminPanel.Views"
        mc:Ignorable="d"
        Title="Virtual Herbarium – Panel administratora"
        Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        
        <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   Background="{DynamicResource PrimaryHueMidBrush}"
                   LastChildFill="True">
            <TextBlock Text="Virtual Herbarium – Panel administratora"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="16,0" />
        </DockPanel>

        
        <StackPanel Grid.Column="0" Grid.Row="1"
                    Background="{DynamicResource MaterialDesignPaper}">
            <TextBlock Text="Nawigacja"
                       Margin="16,16,16,8"
                       FontWeight="Bold"
                       FontSize="14" />
            
            <ListBox SelectedValuePath="Tag"
                     SelectedValue="{Binding SelectedMenu}">
                <ListBoxItem Content="Użytkownicy" Tag="Users" />
                <ListBoxItem Content="Rośliny" Tag="Plants" />
                <ListBoxItem Content="Zbiory" Tag="Collections" />
                <ListBoxItem Content="Powiadomienia" Tag="Notifications" />
                <ListBoxItem Content="Statystyki" Tag="Stats" />
            </ListBox>

        </StackPanel>


        <ContentControl Grid.Column="1" Grid.Row="1"
                Content="{Binding CurrentView}">
        </ContentControl>

    </Grid>
</Window>
