<Window x:Class="VirtualHerbarium.AdminPanel.Views.MovePhotoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MovePhoto_Title}"
        Height="250" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource MovePhoto_SelectTarget}" FontWeight="Bold"/>

        <ListBox x:Name="PlantsList"
                 Grid.Row="1"
                 DisplayMemberPath="name"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource MovePhoto_Cancel}" Width="80" Margin="0 0 10 0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource MovePhoto_Move}" Width="80" Click="Move_Click"/>
        </StackPanel>
    </Grid>
</Window>
