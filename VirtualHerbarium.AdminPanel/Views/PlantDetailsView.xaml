<Window x:Class="VirtualHerbarium.AdminPanel.Views.PlantDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PlantDetails_Title}"
        Height="600" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="{DynamicResource PlantDetails_Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

            <TextBlock Text="{Binding Plant.name}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding Plant.detectedSpecies}" Margin="0 3"/>
            <TextBlock Text="{Binding Plant.family}" Margin="0 3"/>
            <TextBlock Text="{Binding Plant.genus}" Margin="0 3"/>
            <TextBlock Text="{Binding Plant.commonNames}" Margin="0 3"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="{DynamicResource PlantDetails_Photos}" Margin="0 10 0 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Photos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" Margin="0 4" Padding="6">
                                <StackPanel Orientation="Horizontal">

                                    <Image Source="{Binding Image}"
                                           Width="120"
                                           Height="120"
                                           Stretch="UniformToFill"
                                           Margin="0 0 10 0"/>

                                    <StackPanel Width="350">
                                        <TextBlock Text="{Binding Metadata.description}" FontStyle="Italic"/>
                                        <TextBlock Text="{Binding Metadata.confidence, StringFormat='P0'}"/>
                                        <TextBlock Text="{Binding Metadata.createdAt}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">

                                            <Button Content="{DynamicResource PlantDetails_EditDescription}"
                                                    Background="#1976D2"
                                                    Foreground="White"
                                                    Padding="6 3"
                                                    Margin="0 0 6 0"
                                                    Command="{Binding DataContext.EditPhotoDescriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="{DynamicResource PlantDetails_Move}"
                                                    Background="#7B1FA2"
                                                    Foreground="White"
                                                    Padding="6 3"
                                                    Margin="0 0 6 0"
                                                    Command="{Binding DataContext.MovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="{DynamicResource PlantDetails_Delete}"
                                                    Background="#D32F2F"
                                                    Foreground="White"
                                                    Padding="6 3"
                                                    Command="{Binding DataContext.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                        </StackPanel>

                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
