<Window x:Class="VirtualHerbarium.AdminPanel.Views.PlantDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szczegóły rośliny"
        Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Szczegóły rośliny"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

            <TextBlock Text="{Binding Plant.name}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding Plant.detectedSpecies}" Margin="0 3"/>
            <TextBlock Text="{Binding Plant.family}" Margin="0 3"/>
            <TextBlock Text="{Binding Plant.genus}" Margin="0 3"/>
            <TextBlock Text="{Binding Plant.commonNames}" Margin="0 3"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Zdjęcia" Margin="0 10 0 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding Photos}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" Margin="0 4" Padding="6">
                            <StackPanel Orientation="Horizontal">

                                <Image Source="{Binding Image}"
                                       Width="120"
                                       Height="120"
                                       Stretch="UniformToFill"
                                       Margin="0 0 10 0"/>

                                <StackPanel Width="350">
                                    <TextBlock Text="{Binding description}" FontStyle="Italic"/>
                                    <TextBlock Text="{Binding confidence, StringFormat='P0'}"/>
                                    <TextBlock Text="{Binding createdAt}"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
           </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
