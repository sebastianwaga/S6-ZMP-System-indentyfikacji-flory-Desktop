<UserControl x:Class="VirtualHerbarium.AdminPanel.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#1976D2"
                CornerRadius="12"
                Padding="20"
                Margin="8">
            <StackPanel>
                <TextBlock Text="{DynamicResource Stats_Card_Users}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding Users}"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#388E3C"
                CornerRadius="12"
                Padding="20"
                Margin="8">
            <StackPanel>
                <TextBlock Text="{DynamicResource Stats_Card_Plants}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding Plants}"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Background="#F57C00"
                CornerRadius="12"
                Padding="20"
                Margin="8">
            <StackPanel>
                <TextBlock Text="{DynamicResource Stats_Card_Collections}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding Collections}"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
