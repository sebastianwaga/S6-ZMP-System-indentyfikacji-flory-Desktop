<UserControl x:Class="VirtualHerbarium.AdminPanel.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="{DynamicResource Stats_Title}"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <Border Background="#1976D2" CornerRadius="12" Padding="20" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_Users}" Foreground="White" FontSize="20" FontWeight="Bold"/>

                    <UniformGrid Columns="3" Margin="0 10 0 0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Users_All}" Foreground="White"/>
                            <TextBlock Text="{Binding TotalUsers}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Users_Active}" Foreground="White"/>
                            <TextBlock Text="{Binding ActiveUsers}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Users_Inactive}" Foreground="White"/>
                            <TextBlock Text="{Binding InactiveUsers}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Users_Verified}" Foreground="White"/>
                            <TextBlock Text="{Binding VerifiedUsers}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Users_Unverified}" Foreground="White"/>
                            <TextBlock Text="{Binding UnverifiedUsers}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Users_Admins}" Foreground="White"/>
                            <TextBlock Text="{Binding Admins}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Background="#388E3C" CornerRadius="12" Padding="20" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_Herbaria}" Foreground="White" FontSize="20" FontWeight="Bold"/>

                    <UniformGrid Columns="3" Margin="0 10 0 0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Herbaria_All}" Foreground="White"/>
                            <TextBlock Text="{Binding TotalHerbaria}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Herbaria_Public}" Foreground="White"/>
                            <TextBlock Text="{Binding PublicHerbaria}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Herbaria_Private}" Foreground="White"/>
                            <TextBlock Text="{Binding PrivateHerbaria}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Background="#F57C00" CornerRadius="12" Padding="20" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_Plants}" Foreground="White" FontSize="20" FontWeight="Bold"/>

                    <UniformGrid Columns="4" Margin="0 10 0 0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Plants_All}" Foreground="White"/>
                            <TextBlock Text="{Binding TotalPlants}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Plants_Recognized}" Foreground="White"/>
                            <TextBlock Text="{Binding RecognizedPlants}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Plants_Unrecognized}" Foreground="White"/>
                            <TextBlock Text="{Binding UnrecognizedPlants}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Plants_Photos}" Foreground="White"/>
                            <TextBlock Text="{Binding TotalPhotos}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Background="#7B1FA2" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_Friendships}" Foreground="White" FontSize="20" FontWeight="Bold"/>

                    <UniformGrid Columns="2" Margin="0 10 0 0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Friendships_All}" Foreground="White"/>
                            <TextBlock Text="{Binding TotalFriendships}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Stats_Friendships_Pending}" Foreground="White"/>
                            <TextBlock Text="{Binding PendingRequests}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
