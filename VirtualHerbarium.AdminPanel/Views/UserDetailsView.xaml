<Window x:Class="VirtualHerbarium.AdminPanel.Views.UserDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UserDetails_Title}"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="{DynamicResource UserDetails_Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Text="{Binding UsernameDisplay}" FontSize="16" FontWeight="Bold"/>

            <Separator Margin="0 10"/>

            <TextBlock Text="{Binding EmailDisplay}" Margin="0 5"/>
            <TextBlock Text="{Binding CreatedDisplay}" Margin="0 5"/>
            <TextBlock Text="{Binding UpdatedDisplay}" Margin="0 5"/>

            <Separator Margin="0 10"/>

            <TextBlock Text="{Binding StatsDisplay}" Margin="0 5"/>

            <Separator Margin="0 10"/>

            <TextBlock Text="{DynamicResource UserDetails_Herbaria}" FontWeight="Bold" Margin="0 5"/>

            <ListBox ItemsSource="{Binding Herbaria}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0 5">
                            <TextBlock Text="{Binding name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding description}" FontStyle="Italic"/>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{StaticResource UserDetails_PlantsCount}">
                                        <Binding Path="plantCount"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>

    </Grid>
</Window>
