<Window x:Class="VirtualHerbarium.AdminPanel.Views.UserFriendsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UserFriends_Title}"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="{DynamicResource UserFriends_Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Text="{DynamicResource UserFriends_Accepted}" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding Accepted}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding username}" Margin="0 3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Separator Margin="0 10"/>

            <TextBlock Text="{DynamicResource UserFriends_Incoming}" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding Incoming}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding username}" Margin="0 3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Separator Margin="0 10"/>

            <TextBlock Text="{DynamicResource UserFriends_Sent}" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding Sent}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding username}" Margin="0 3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>

    </Grid>
</Window>
