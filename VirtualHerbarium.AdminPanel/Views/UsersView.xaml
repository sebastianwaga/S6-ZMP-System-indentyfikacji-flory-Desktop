<UserControl x:Class="VirtualHerbarium.AdminPanel.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="12"
                Padding="16"
                SnapsToDevicePixels="True">

            <DataGrid ItemsSource="{Binding Users}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="40"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#388E3C"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="{DynamicResource Users_Header_Email}"
                                        Binding="{Binding email}" Width="200" />

                    <DataGridTextColumn Header="{DynamicResource Users_Header_Username}"
                                        Binding="{Binding username}" Width="150" />

                    <DataGridCheckBoxColumn Header="{DynamicResource Users_Header_Active}"
                                            Binding="{Binding active}" Width="80" />

                    <DataGridCheckBoxColumn Header="{DynamicResource Users_Header_Verified}"
                                            Binding="{Binding verified}" Width="100" />

                    <DataGridCheckBoxColumn Header="{DynamicResource Users_Header_Admin}"
                                            Binding="{Binding admin}" Width="80" />

                    <DataGridTemplateColumn Header="{DynamicResource Users_Header_Actions}" Width="Auto" MinWidth="650">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <Button Content="{DynamicResource Users_Action_Details}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0288D1"
                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="{DynamicResource Users_Action_Friends}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#7B1FA2"
                                            Command="{Binding DataContext.ShowFriendsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="{DynamicResource Users_Action_Ban}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#D32F2F"
                                            Command="{Binding DataContext.BanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="{DynamicResource Users_Action_Unban}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#4CAF50"
                                            Command="{Binding DataContext.UnbanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="{DynamicResource Users_Action_MakeAdmin}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#1976D2"
                                            Command="{Binding DataContext.MakeAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="{DynamicResource Users_Action_RemoveAdmin}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#757575"
                                            Command="{Binding DataContext.RemoveAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="{DynamicResource Users_Action_Warning}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#FFA000"
                                            Command="{Binding DataContext.WarningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="{DynamicResource Users_Action_Delete}"
                                            Style="{StaticResource ActionButton}"
                                            Background="#B71C1C"
                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
